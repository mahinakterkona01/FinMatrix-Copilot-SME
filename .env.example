APP_ENV=development
LOG_LEVEL=INFO
EXECUTION_MODE=sandbox
REQUIRE_HITL_APPROVAL=true

# Local Ollama is optional. Enable it explicitly in your local .env.
FINMATRIX_LLM_PROVIDER=ollama
FINMATRIX_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional OpenAI provider; disabled by default.
# Put any real API key only in local .env. Never commit it.
FINMATRIX_ENABLE_OPENAI=false
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=your_openai_api_key_here
